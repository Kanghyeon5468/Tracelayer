rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cases/{caseId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['analyst', 'supervisor', 'compliance'];
      allow write: if request.auth != null
        && request.auth.token.role in ['service', 'supervisor'];
    }

    match /approvals/{approvalId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['supervisor', 'compliance'];
      allow write: if request.auth != null
        && request.auth.token.role == 'supervisor';
    }

    match /auditEvents/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.role == 'compliance';
      allow write: if false;
    }
  }
}
