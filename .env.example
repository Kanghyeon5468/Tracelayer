APP_ENV=local
APP_NAME=tracelayer
LOG_LEVEL=INFO

# Use mock mode for local demos. Set to "false" when wiring production services.
USE_MOCK_DATA=true

# AI provider configuration. Keep secrets backend-only.
# Supported values: mock, gemini_api, vertex_ai, auto.
AI_PROVIDER=vertex_ai

# Gemini API mode uses GEMINI_API_KEY on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ADK_MODEL=gemini-3.5-flash

# Vertex AI mode uses Application Default Credentials locally or a Cloud Run service account.
GOOGLE_CLOUD_PROJECT=project-6ecbea1e-e0c3-4325-a63
GOOGLE_CLOUD_LOCATION=us
AGENT_REGISTRY_LOCATION=us-central1
GOOGLE_API_USE_MTLS_ENDPOINT=never
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
PUBLIC_SERVICE_URL=https://tracelayer-api-235426782310.us-central1.run.app
TRIAGE_AGENT_ENGINE_RESOURCE=
TRIAGE_AGENT_RUNTIME_PRINCIPAL=

# Google Cloud Model Armor. Leave auto/local for deterministic local demos.
MODEL_ARMOR_BACKEND=auto
MODEL_ARMOR_PROJECT=project-6ecbea1e-e0c3-4325-a63
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=tracelayer-prompt-shield
MODEL_ARMOR_FAIL_CLOSED=false

# Google Cloud resource names for deployed mode.
FIRESTORE_DATABASE=(default)
FIRESTORE_CASE_COLLECTION=tracelayer_cases
FIRESTORE_JOB_COLLECTION=tracelayer_investigation_jobs
BIGQUERY_DATASET=fraud_investigations
BIGQUERY_TRANSACTIONS_TABLE=project-6ecbea1e-e0c3-4325-a63.fraud_investigations.transactions
NETWORK_SEARCH_BACKEND=auto
NETWORK_SEARCH_LIMIT=50
NETWORK_SEARCH_TIMEOUT_SECONDS=3
PUBSUB_TOPIC_INVESTIGATIONS=tracelayer-investigations
PUBSUB_TOPIC_APPROVALS=tracelayer-approvals

# Local API security. Keep permissive for demos, use enforcing for deployed services.
SECURITY_MODE=permissive
DEMO_ANALYST_API_KEY=local-demo-key
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,file://
AUDIT_LEDGER_PATH=../../data/audit/audit-ledger.jsonl
MEMORY_BACKEND=local
MEMORY_BANK_PATH=../../data/memory/case-memory.jsonl
INVESTIGATION_JOB_PATH=../../data/memory/investigation-jobs.jsonl
