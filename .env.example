APP_ENV=local
APP_NAME=tracelayer
LOG_LEVEL=INFO

# Use mock mode for local demos. Set to "false" when wiring production services.
USE_MOCK_DATA=true

# Gemini API configuration. Either GEMINI_API_KEY or Vertex AI identity can be used later.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud resource names for deployed mode.
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=fraud_investigations
PUBSUB_TOPIC_INVESTIGATIONS=tracelayer-investigations
PUBSUB_TOPIC_APPROVALS=tracelayer-approvals

# Local API security. Keep permissive for demos, use enforcing for deployed services.
SECURITY_MODE=permissive
DEMO_ANALYST_API_KEY=local-demo-key
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,file://
AUDIT_LEDGER_PATH=../../data/audit/audit-ledger.jsonl
MEMORY_BANK_PATH=../../data/memory/case-memory.jsonl
